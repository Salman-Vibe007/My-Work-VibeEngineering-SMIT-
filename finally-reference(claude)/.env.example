# ---------- AI chat ----------
# Required for the real AI (leave the placeholder when using LLM_MOCK=true)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# "true" = deterministic fake AI replies (tests / first run, no key needed)
LLM_MOCK=false

# ---------- Market data ----------
# Optional: real prices via Alpha Vantage (https://www.alphavantage.co/support/#api-key). Empty = built-in simulator.
ALPHAVANTAGE_API_KEY=
# Match these to YOUR Alpha Vantage plan (the free plan allows very few requests per day; check their site).
ALPHAVANTAGE_DAILY_LIMIT=25
ALPHAVANTAGE_REQUESTS_PER_MINUTE=5

# ---------- Supabase (login + database) ----------
# Leave ALL THREE empty for demo mode: no login, one shared account, data in a local SQLite file.
# Fill SUPABASE_URL + SUPABASE_ANON_KEY to require login (email + password) for every user.
# Fill SUPABASE_DB_URL as well to store the data in your Supabase Postgres database.
# See SETUP_SUPABASE.md for exactly where to find each value.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
