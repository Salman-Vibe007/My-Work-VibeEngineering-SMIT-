{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@prelegal/shared/*": ["../../packages/shared/src/*"],
      "@prelegal/validation/*": ["../../packages/validation/src/*"],
      "@prelegal/ui/*": ["../../packages/ui/src/*"],
      "@prelegal/template-engine/*": ["../../packages/template-engine/src/*"],
      "@prelegal/document-engine/*": ["../../packages/document-engine/src/*"],
      "@prelegal/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}