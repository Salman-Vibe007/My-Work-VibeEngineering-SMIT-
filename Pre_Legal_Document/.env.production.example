# Production Environment Variables for Vercel
# Copy these to Vercel Project Settings > Environment Variables

# Application
NODE_ENV=production
APP_NAME="Pre Legal Document Generator"
APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Database (Use Vercel Postgres or external PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/prelegal?schema=public
POSTGRES_PASSWORD=generate-secure-password

# Redis (Use Vercel KV or external Redis)
REDIS_URL=redis://user:password@host:6379
REDIS_PASSWORD=generate-secure-password

# Authentication
AUTH_SECRET=generate-32-char-random-string
AUTH_URL=https://your-domain.com

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Email (Resend recommended)
EMAIL_FROM=noreply@your-domain.com
EMAIL_API_KEY=re_xxxxxxxxxxxx
EMAIL_PROVIDER=resend

# Object Storage (Optional - for file exports)
STORAGE_ENDPOINT=https://s3.region.amazonaws.com
STORAGE_BUCKET=prelegal-documents
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_REGION=us-east-1

# Billing (Stripe)
PAYMENT_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYMENT_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_API_VERSION=2024-04-10

# AI Provider (Optional)
AI_PROVIDER=openai
AI_API_KEY=sk-xxxxxxxxxxxx
AI_MODEL=gpt-4-turbo-preview

# Error Reporting (Optional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=prelegal

# Feature Flags
ENABLE_AI_ASSISTANCE=true
ENABLE_WORKSPACES=true
ENABLE_E_SIGNATURES=false
ENABLE_DARK_MODE=true

# Cron Jobs
CRON_SECRET=generate-secure-random-string

# Security
NEXT_PUBLIC_CSP_NONCE=