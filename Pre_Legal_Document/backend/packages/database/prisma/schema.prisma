generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  USER
  PROFESSIONAL
  WORKSPACE_MEMBER
  WORKSPACE_OWNER
  ADMINISTRATOR
}

enum DocumentStatus {
  DRAFT
  COMPLETED
  ARCHIVED
  DELETED
}

enum TemplateStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum TemplateCategory {
  BUSINESS
  EMPLOYMENT
  FREELANCING
  PERSONAL
  PROPERTY
  FINANCE
  DISPUTES
  GENERAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum PlanInterval {
  MONTH
  YEAR
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobType {
  PDF_GENERATION
  DOCX_GENERATION
  AI_SUGGESTION
  EMAIL_SEND
  EXPORT
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  passwordHash    String?
  image           String?
  locale          String    @default("en")
  preferredJurisdiction String?
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  accounts        Account[]
  sessions        Session[]
  organizations   OrganizationMember[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  documents       Document[] @relation("DocumentOwner")
  documentVersions DocumentVersion[] @relation("DocumentVersionAuthor")
  shares          DocumentShare[] @relation("ShareCreator")
  usageRecords    UsageRecord[]
  subscriptions   Subscription[]
  auditLogs       AuditLog[]
  reviewedTemplates Template[]     @relation("TemplateReviewer")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members     OrganizationMember[]
  documents   Document[]
  templates   Template[]
  subscriptions Subscription[]
  usageRecords UsageRecord[]

  @@index([ownerId])
  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole @default(WORKSPACE_MEMBER)
  joinedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Plan {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  description     String?
  priceMonthly    Int          @default(0)
  priceYearly     Int          @default(0)
  interval        PlanInterval @default(MONTH)
  features        Json
  limits          Json
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptions   Subscription[]

  @@index([slug])
  @@index([isActive])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String?
  organizationId         String?
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId       String?
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialStart             DateTime?
  trialEnd               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  plan         Plan          @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

model Template {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  description   String?          @db.Text
  category        TemplateCategory
  jurisdictionCountry String
  jurisdictionRegion String?
  isPremium       Boolean          @default(false)
  status          TemplateStatus   @default(DRAFT)
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?

  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation("TemplateReviewer", fields: [reviewedById], references: [id])

  versions        TemplateVersion[]
  documents       Document[]

  @@index([category])
  @@index([status])
  @@index([organizationId])
  @@index([isPremium])
}

model TemplateVersion {
  id              String   @id @default(uuid())
  templateId      String
  version         Int
  schema          Json
  content         Json
  jurisdictionCountry String
  jurisdictionRegion String?
  reviewStatus    String?
  reviewerId      String?
  reviewedAt      DateTime?
  changelog       String?  @db.Text
  createdAt       DateTime @default(now())

  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documents       Document[]

  @@unique([templateId, version])
  @@index([templateId])
}

model Document {
  id                  String         @id @default(uuid())
  title               String
  status              DocumentStatus @default(DRAFT)
  ownerId             String
  organizationId      String?
  templateId          String
  templateVersionId   String
  currentVersionId    String?        @unique
  jurisdictionCountry String
  jurisdictionRegion  String?
  isFavorite          Boolean        @default(false)
  isPinned            Boolean        @default(false)
  tags                String[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  completedAt         DateTime?
  deletedAt           DateTime?

  owner               User           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  template            Template       @relation(fields: [templateId], references: [id])
  templateVersion     TemplateVersion @relation(fields: [templateVersionId], references: [id])
  currentVersion      DocumentVersion? @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  versions            DocumentVersion[]
  shares              DocumentShare[]
  generationJobs      GenerationJob[]
  usageRecords        UsageRecord[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
  @@index([ownerId, status])
}

model DocumentVersion {
  id              String   @id @default(uuid())
  documentId      String
  version         Int
  content         Json
  formData        Json
  authorId        String
  aiAssisted      Boolean  @default(false)
  aiProvider      String?
  aiModel         String?
  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  currentDocument Document? @relation("DocumentCurrentVersion")
  author          User     @relation("DocumentVersionAuthor", fields: [authorId], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@index([authorId])
}

model DocumentShare {
  id            String   @id @default(uuid())
  documentId    String
  creatorId     String
  accessCode    String   @unique @default(uuid())
  expiresAt     DateTime?
  maxViews      Int?
  viewCount     Int      @default(0)
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator       User     @relation("ShareCreator", fields: [creatorId], references: [id])

  @@index([documentId])
  @@index([accessCode])
  @@index([creatorId])
}

model GenerationJob {
  id          String     @id @default(uuid())
  documentId  String
  type        JobType
  status      JobStatus  @default(PENDING)
  input       Json
  output      Json?
  error       String?    @db.Text
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
  @@index([type])
}

model UsageRecord {
  id            String   @id @default(uuid())
  userId        String
  documentId    String?
  organizationId String?
  type          String
  count         Int      @default(1)
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, periodStart])
  @@index([organizationId, periodStart])
  @@index([documentId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  eventType       String
  eventId         String   @unique
  payload         Json
  processed       Boolean  @default(false)
  processedAt     DateTime?
  error           String?  @db.Text
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([provider, eventType])
  @@index([processed])
  @@index([createdAt])
}