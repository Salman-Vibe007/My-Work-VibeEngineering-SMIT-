{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "test:e2e": {
      "outputs": ["playwright-report/**"],
      "dependsOn": ["build"]
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "db:migrate": {
      "outputs": ["prisma/migrations/**"]
    },
    "db:seed": {},
    "db:studio": {
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "AUTH_SECRET"]
}