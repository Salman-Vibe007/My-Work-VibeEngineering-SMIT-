# Application
NODE_ENV=development
APP_NAME="Pre Legal Document Generator"
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/prelegal
DIRECT_URL=postgresql://postgres:change-me@localhost:5432/prelegal
POSTGRES_PASSWORD=change-me

# Optional background jobs
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication
AUTH_SECRET=replace-with-a-cryptographically-random-secret
AUTH_URL=http://localhost:3000

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email
EMAIL_FROM=documents@example.com
EMAIL_API_KEY=
EMAIL_PROVIDER=resend

# Optional private object storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=prelegal-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Optional billing (Stripe)
PAYMENT_SECRET_KEY=
PAYMENT_PUBLISHABLE_KEY=
PAYMENT_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-04-10

# Optional AI provider
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional error reporting
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Feature flags
ENABLE_AI_ASSISTANCE=false
ENABLE_WORKSPACES=false
ENABLE_E_SIGNATURES=false
ENABLE_DARK_MODE=true