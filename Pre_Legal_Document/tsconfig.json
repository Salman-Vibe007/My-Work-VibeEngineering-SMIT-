{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@prelegal/shared/*": ["backend/packages/shared/src/*"],
      "@prelegal/validation/*": ["backend/packages/validation/src/*"],
      "@prelegal/ui/*": ["backend/packages/ui/src/*"],
      "@prelegal/template-engine/*": ["backend/packages/template-engine/src/*"],
      "@prelegal/document-engine/*": ["backend/packages/document-engine/src/*"],
      "@prelegal/database/*": ["backend/packages/database/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/build", "**/.next"]
}