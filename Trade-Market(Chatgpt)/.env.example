# Supabase -> Project Settings -> API (use the publishable key, never the service role key here)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. Needed only by protected admin API routes. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Massive Data market data. Keep this server-side; your plan determines symbol coverage and real-time/delayed entitlements.
MASSIVE_API_KEY=YOUR_MASSIVE_API_KEY

# Optional OpenAI-compatible chat endpoint. If empty, the assistant reports that it is not configured.
AI_BASE_URL=https://openrouter.ai/
AI_API_KEY=YOUR_AI_PROVIDER_API_KEY
AI_MODEL=YOUR_MODEL_NAME
